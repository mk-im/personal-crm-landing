---
import { APP_URL } from "../config";

interface Props {
  variant?: "hero" | "final";
}

const { variant = "hero" } = Astro.props;

const sizes = {
  hero: {
    link: "gap-3.5 rounded-r14 py-1.5 pr-1.5 pl-6 text-btn lg:gap-4 lg:rounded-r16 lg:py-2 lg:pr-2 lg:pl-7 lg:text-btn-lg",
    icon: "size-10.5 rounded-r10 text-ui-18 lg:size-12.5 lg:rounded-r12 lg:text-ui-20",
  },
  final: {
    link: "w-full justify-between rounded-r16 py-2 pr-2 pl-6 text-btn-final lg:w-110 lg:rounded-r18 lg:py-2.5 lg:pr-2.5 lg:pl-8 lg:text-btn-final-lg",
    icon: "size-12 rounded-r12 text-ui-18 lg:size-14 lg:rounded-r14 lg:text-ui-20",
  },
}[variant];
---

<a
  href={APP_URL}
  class:list={[
    "group relative inline-flex items-center bg-black font-semibold text-white no-underline transition-colors hover:bg-black-soft focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-sky",
    sizes.link,
  ]}
>
  Открыть приложение
  <span
    class:list={[
      "grid place-items-center bg-white text-black transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5",
      sizes.icon,
    ]}
    aria-hidden="true">↗</span
  >
</a>
